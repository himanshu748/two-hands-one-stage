# Copy to .env locally. Do not commit .env or paste credentials into Mattermost.
# Only the application API opens this SQLite database. No implicit synthetic mode.
# Relative database and identity paths resolve from the repository root.
DATABASE_PATH=work/demo.sqlite
# Explicit opt-in for pnpm demo:reset. Must exactly resolve to DATABASE_PATH.
DISPOSABLE_DEMO_DATABASE_PATH=work/demo.sqlite
API_URL=http://127.0.0.1:4310
# Artifact links sent through Switch must open on the performer's actual device.
# For the same-machine local demonstration, the workbench proxies them to the API.
# pnpm dev uses this loopback URL's port; choose another free port if 5173 is occupied.
PUBLIC_APP_URL=http://127.0.0.1:5173

# Agent bridge base URL (not Gateway URL). Verify GET /health first.
SWITCH_BASE_URL=
SWITCH_ROOM_ID=
# Used once by pnpm register:agents; never use this as an agent API key.
SWITCH_REGISTRATION_TOKEN=

# Separate registered Switch identities. Sender IDs are opaque runtime participant IDs.
WRITER_SWITCH_AGENT_ID=
WRITER_SWITCH_API_KEY=
WRITER_SWITCH_SENDER=
STAGE_SWITCH_AGENT_ID=
STAGE_SWITCH_API_KEY=
STAGE_SWITCH_SENDER=
# Names registered by scripts/register-agents.ts, for explicit room mentions.
WRITER_SWITCH_NAME=two-hands-writer
STAGE_SWITCH_NAME=two-hands-stage

# Distinct random secrets, at least 32 characters each. Generate locally, e.g.:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WRITER_INTERNAL_TOKEN=
STAGE_INTERNAL_TOKEN=

# Explicit backend, using the official OpenAI SDK for either API.
# Defaults to openai for existing configurations. No automatic fallback.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# For MODEL_PROVIDER=modal, OpenAI credentials are not required.
# Read docs/modal-setup.md before provisioning or making paid requests.
# Use the endpoint's actual model ID, not an assumed Hugging Face name.
MODAL_BASE_URL=
MODAL_MODEL=
# Combined proxy token: wk-<id>.ws-<secret>. NOT your Modal CLI token.
MODAL_PROXY_TOKEN=

# Reviewed local mapping file, outside tracked files. See compatibility and state docs.
# Missing mapping permits the API's read-only view; pnpm dev requires it.
HUMAN_IDENTITY_FILE=work/human-identity.json
